{
    "name": "mgamadeus/ddd-ai",
    "description": "AI model management, prompt system, and Argus AI integration traits for mgamadeus/ddd",
    "minimum-stability": "stable",
    "license": "MIT",
    "homepage": "https://github.com/ddd-framework/ddd-ai",
    "support": {
        "issues": "https://github.com/ddd-framework/ddd-ai/issues",
        "source": "https://github.com/ddd-framework/ddd-ai"
    },
    "version": "3.2.0",
    "authors": [
        {
            "name": "Marius-Eugen Gerdan",
            "email": "marius@gerdan.net"
        }
    ],
    "require": {
        "mgamadeus/ddd-argus": "^1.3.2",
        "mgamadeus/ddd": "^3.19.0",
        "mgamadeus/ddd-common-money": "^1.1.1",
        "gioni06/gpt3-tokenizer": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "DDD\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DDD\\Tests\\AI\\": "tests/"
        }
    },
    "extra": {
        "ddd-module": "DDD\\Modules\\AI\\AIModule"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    }
}
